<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Notas de Manutenção</title>
<style>
  :root {
    --primary-color: #00796b;
    --secondary-color: #4db6ac;
    --background-color-light: #e0f2f1;
    --text-color-light: #333;
    --shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    --machine11-color: #2f7a5f;
    --machine9-color: #0d47a1;
    --toast-success: #4caf50;
    --toast-error: #d32f2f;
  }
  body {
    font-family: 'Arial', sans-serif;
    margin: 0;
    background-color: var(--background-color-light);
    color: var(--text-color-light);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    padding: 10px;
    box-sizing: border-box;
  }
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100vh;
    text-align: center;
    width: 100%;
    max-width: 900px;
  }
  h1 {
    margin-bottom: 20px;
    font-size: 2.5em;
    color: var(--primary-color);
  }
  button {
    margin: 8px 10px;
    padding: 12px 28px;
    border: none;
    border-radius: 5px;
    background-color: var(--primary-color);
    color: white;
    font-size: 18px;
    cursor: pointer;
    transition: background-color 0.3s, transform 0.2s;
  }
  button:hover:not(:disabled) {
    background-color: #00695c;
    transform: scale(1.05);
  }
  button:disabled {
    background-color: #999;
    cursor: default;
    transform: none;
  }
  #homeContainer {
    flex-grow: 1;
    justify-content: center;
  }
  #noteSection {
    display: none;
    flex-direction: column;
    width: 100%;
    max-width: 900px;
    background-color: #fff;
    border-radius: 10px;
    box-shadow: var(--shadow);
    padding: 20px;
    box-sizing: border-box;
  }
  .sidebar {
    background-color: var(--primary-color);
    color: white;
    padding: 10px 15px;
    border-radius: 8px;
    margin-bottom: 12px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .sidebar h2 {
    flex-basis: 100%;
    margin: 0 0 10px 0;
    font-size: 22px;
    text-align: center;
  }
  .sidebar button,
  .sidebar input[type="search"],
  .sidebar select {
    flex-grow: 1;
    min-width: 120px;
    max-width: 180px;
    font-size: 14px;
    padding: 8px 10px;
    border-radius: 5px;
    border: none;
    box-sizing: border-box;
    outline-offset: 1px;
  }
  .sidebar input[type="search"]:focus,
  .sidebar select:focus {
    border-color: var(--secondary-color);
    outline: 2px solid var(--secondary-color);
    color: #000;
  }
  #noteEditor {
    width: 100%;
    padding: 12px;
    font-size: 16px;
    resize: none;
    border-radius: 8px;
    border: 1px solid #ccc;
    box-shadow: var(--shadow);
    box-sizing: border-box;
    font-family: inherit;
    min-height: 170px;
    max-height: 320px;
    overflow-y: auto;
  }
  #notesDisplay {
    margin-top: 8px;
    max-height: 250px;
    overflow-y: auto;
    border: 1px solid #ccc;
    border-radius: 8px;
    box-shadow: var(--shadow);
    padding: 10px;
    background: #fafafa;
  }
  .note {
    background-color: white;
    border: 1px solid #bbb;
    border-radius: 6px;
    margin-bottom: 8px;
    padding: 10px;
    box-sizing: border-box;
    box-shadow: 1px 1px 5px rgba(0, 0, 0, 0.05);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .note-text {
    white-space: pre-wrap;
    font-size: 15px;
    flex: 1 1 auto;
    margin-right: 10px;
  }
  .note-date {
    font-size: 12px;
    color: #666;
  }
  .note-buttons {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .edit-button,
  .delete-button {
    padding: 5px 10px;
    font-size: 13px;
    border-radius: 5px;
    border: none;
    cursor: pointer;
    width: 60px;
  }
  .edit-button {
    background-color: #ffd54f;
    color: #000;
  }
  .edit-button:hover {
    background-color: #ffca28;
  }
  .delete-button {
    background-color: #d32f2f;
    color: white;
  }
  .delete-button:hover {
    background-color: #9a2222;
  }
  #toast {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background-color: var(--toast-success);
    color: white;
    padding: 10px 20px;
    border-radius: 5px;
    opacity: 0.9;
    transition: opacity 0.5s;
    z-index: 9999;
    user-select: none;
  }
  #toast.error {
    background-color: var(--toast-error);
  }
  #toast.hide {
    opacity: 0;
    pointer-events: none;
  }
  .machine-tab {
    cursor: pointer;
    padding: 10px 20px;
    border-radius: 5px;
    font-weight: 600;
    border: 2px solid transparent;
    transition: all 0.3s ease;
    color: white;
  }
  .machine-tab.machine11 {
    background-color: var(--machine11-color);
  }
  .machine-tab.machine9 {
    background-color: var(--machine9-color);
  }
  .machine-tab.active {
    background-color: white !important;
    color: var(--primary-color);
    border-color: var(--primary-color);
  }
</style>
</head>
<body>
  <div class="container" id="homeContainer" role="main">
    <h1>Notas de Manutenção</h1>
    <button id="openPTButton" type="button" aria-label="Abrir área de notas">Abrir PT</button>
    <button id="openPDFBtn" type="button" aria-label="Abrir PDF">PDF</button>
  </div>

  <section class="note-section" id="noteSection" aria-label="Área de notas" hidden>
    <aside class="sidebar" aria-label="Controles das notas">
      <h2>Notas</h2>
      <div id="machineTabs" role="tablist" aria-label="Seleção de máquina">
        <button class="machine-tab machine11 active" id="tab-machine11" role="tab" aria-selected="true" aria-controls="notesDisplay" tabindex="0">Máquina 11</button>
        <button class="machine-tab machine9" id="tab-machine9" role="tab" aria-selected="false" aria-controls="notesDisplay" tabindex="-1">Máquina 9</button>
      </div>
      <input type="search" id="searchInput" placeholder="Buscar nas notas..." aria-label="Buscar nas notas" />
      <label for="machineSelector" class="visually-hidden">Selecionar máquina para salvar a nota</label>
      <select id="machineSelector" aria-describedby="machineHelp" title="Selecione a máquina para salvar a nota">
        <option value="Máquina 11">Máquina 11</option>
        <option value="Máquina 9">Máquina 9</option>
      </select>
      <span id="machineHelp" class="visually-hidden">Selecione a máquina para onde a nota será salva</span>
      <button id="newNoteBtn" type="button" aria-label="Salvar nota">Salvar Nota</button>
      <button id="exportNotesBtn" type="button" aria-label="Exportar notas">Exportar Notas</button>
      <button id="printNotesBtn" type="button" aria-label="Imprimir notas">Imprimir Notas</button>
    </aside>
    <main class="main-area">
      <textarea id="noteEditor" placeholder="Escreva sua nota aqui..." aria-label="Editor de nota" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"></textarea>
      <div id="notesDisplay" tabindex="0" aria-live="polite" aria-atomic="true" aria-label="Lista de notas"></div>
    </main>
  </section>

  <div id="toast" class="toast hide" role="alert" aria-live="assertive"></div>

  <script>
    (() => {
      const notesKey = 'maintenanceNotes';
      let notes = [];
      try {
        const storedNotes = localStorage.getItem(notesKey);
        if (storedNotes) {
          notes = JSON.parse(storedNotes);
          if (!Array.isArray(notes)) throw new Error('Dados inválidos');
        }
      } catch {
        notes = [];
        localStorage.removeItem(notesKey);
      }

      let currentMachine = 'Máquina 11';

      const homeContainer = document.getElementById('homeContainer');
      const noteSection = document.getElementById('noteSection');
      const openPTButton = document.getElementById('openPTButton');
      const openPDFBtn = document.getElementById('openPDFBtn');
      const machine11Tab = document.getElementById('tab-machine11');
      const machine9Tab = document.getElementById('tab-machine9');
      const searchInput = document.getElementById('searchInput');
      const machineSelector = document.getElementById('machineSelector');
      const noteEditor = document.getElementById('noteEditor');
      const notesDisplay = document.getElementById('notesDisplay');
      const newNoteBtn = document.getElementById('newNoteBtn');
      const exportNotesBtn = document.getElementById('exportNotesBtn');
      const printNotesBtn = document.getElementById('printNotesBtn');
      const toast = document.getElementById('toast');

      let toastTimeout;

      function showToast(msg, isError = false) {
        clearTimeout(toastTimeout);
        toast.textContent = msg;
        toast.classList.remove('hide');
        toast.classList.toggle('error', isError);
        toastTimeout = setTimeout(() => toast.classList.add('hide'), 3000);
      }

      function saveNotes() {
        try {
          localStorage.setItem(notesKey, JSON.stringify(notes));
        } catch {
          showToast('Erro ao salvar notas no localStorage.', true);
        }
      }

      function formatNoteContent(text) {
        return text
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/(^|\s)(#[a-zA-Z0-9]+)/g, '$1<span style="color:blue;">$2</span>')
          .replace(/(^|\s)([-*])\s/g, '$1<span style="color:green;">$2 </span>')
          .replace(/\n/g, '<br/>');
      }

      function renderNotes() {
        const searchTerm = searchInput.value.toLowerCase();
        notesDisplay.innerHTML = '';

        const filteredNotes = notes.filter(note =>
          note.machine === currentMachine &&
          note.text.toLowerCase().includes(searchTerm)
        );

        if (!filteredNotes.length) {
          notesDisplay.innerHTML = '<p>Nenhuma nota encontrada.</p>';
          return;
        }

        filteredNotes.forEach(note => {
          const noteDiv = document.createElement('div');
          noteDiv.className = 'note';
          noteDiv.setAttribute('tabindex', '0');
          noteDiv.innerHTML = `
            <div class="note-text">${formatNoteContent(note.text)}</div>
            <div>
              <div class="note-date">${note.date}</div>
              <div class="note-buttons" style="margin-top:8px; display:flex; gap:6px;">
                <button class="edit-button" aria-label="Editar nota" title="Editar" type="button">Editar</button>
                <button class="delete-button" aria-label="Excluir nota" title="Excluir" type="button">Excluir</button>
              </div>
            </div>
          `;

          const editBtn = noteDiv.querySelector('.edit-button');
          const deleteBtn = noteDiv.querySelector('.delete-button');

          editBtn.onclick = () => {
            noteEditor.value = note.text;
            machineSelector.value = note.machine;
            const idx = notes.findIndex(n => n.id === note.id);
            if (idx > -1) {
              notes.splice(idx, 1);
              saveNotes();
              renderNotes();
              showToast('Nota carregada para edição. Faça as alterações e salve.');
            }
          };

          deleteBtn.onclick = () => {
            if (confirm('Tem certeza que deseja excluir esta nota?')) {
              const idx = notes.findIndex(n => n.id === note.id);
              if (idx > -1) {
                notes.splice(idx, 1);
                saveNotes();
                renderNotes();
                showToast('Nota excluída com sucesso!');
              }
            }
          };

          notesDisplay.appendChild(noteDiv);
        });
      }

      // Generate unique IDs for notes
      function generateId() {
        return '_' + Math.random().toString(36).substr(2, 9);
      }

      function addOrUpdateNote() {
        const text = noteEditor.value.trim();
        const machine = machineSelector.value;
        if (!text) {
          showToast('Erro: Nota vazia!', true);
          return;
        }
        notes.push({ id: generateId(), machine, text, date: new Date().toLocaleString() });
        saveNotes();
        noteEditor.value = '';
        renderNotes();
        showToast('Nota salva com sucesso!');
      }

      function exportNotes() {
        const blob = new Blob([JSON.stringify(notes, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'notas.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        showToast('Notas exportadas com sucesso!');
      }

      function printNotes() {
        const printWindow = window.open('', '', 'height=600,width=800');
        printWindow.document.write('<html><head><title>Imprimir Notas</title></head><body>');
        printWindow.document.write(notes
          .filter(note => note.machine === currentMachine)
          .map(note =>
            `<h3>${formatNoteContent(note.text)}</h3><p class="note-date">${note.date}</p>`
          ).join(''));
        printWindow.document.write('</body></html>');
        printWindow.document.close();
        printWindow.print();
      }

      function setActiveMachineTab(targetMachine) {
        currentMachine = targetMachine;
        if (targetMachine === 'Máquina 11') {
          machine11Tab.classList.add('active');
          machine11Tab.setAttribute('aria-selected', 'true');
          machine9Tab.classList.remove('active');
          machine9Tab.setAttribute('aria-selected', 'false');
        } else {
          machine9Tab.classList.add('active');
          machine9Tab.setAttribute('aria-selected', 'true');
          machine11Tab.classList.remove('active');
          machine11Tab.setAttribute('aria-selected', 'false');
        }
        machineSelector.value = currentMachine;
        renderNotes();
      }

      // Event Listeners
      openPTButton.addEventListener('click', () => {
        homeContainer.style.display = 'none';
        noteSection.style.display = 'flex';
        setActiveMachineTab('Máquina 11'); // default
        renderNotes();
      });

      openPDFBtn.addEventListener('click', () => {
        alert('Função PDF ainda não implementada.');
      });

      machine11Tab.addEventListener('click', () => setActiveMachineTab('Máquina 11'));
      machine9Tab.addEventListener('click', () => setActiveMachineTab('Máquina 9'));

      searchInput.addEventListener('input', () => renderNotes());

      newNoteBtn.addEventListener('click', addOrUpdateNote);

      exportNotesBtn.addEventListener('click', exportNotes);

      printNotesBtn.addEventListener('click', printNotes);

      machineSelector.addEventListener('change', e => {
        setActiveMachineTab(e.target.value);
      });

      document.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
          e.preventDefault();
          addOrUpdateNote();
        }
      });

      // Accessibility: keyboard for tabs (left/right arrow)
      [machine11Tab, machine9Tab].forEach(tab => {
        tab.addEventListener('keydown', e => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            if (e.key === 'ArrowRight') {
              if (tab === machine11Tab) machine9Tab.focus();
              else machine11Tab.focus();
            } else {
              if (tab === machine9Tab) machine11Tab.focus();
              else machine9Tab.focus();
            }
          }
        });
      });
    })();
  </script>
</body>
</html>
